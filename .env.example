# Copy this file to .env and fill in what you need. Never commit .env.
# Every value is optional; the defaults below are used when a line is missing.

# --- AI provider (free tiers only) ---
# gemini (default), groq or ollama
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Model names. Leave empty for the defaults: gemini-2.5-flash, llama-3.3-70b-versatile, qwen2.5-coder:7b
GEMINI_MODEL=
GROQ_MODEL=
OLLAMA_MODEL=
# Only for Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
# 0 = skip the LLM checklist review and open question (scanners and rule checks still run)
CODEGUARD_LLM_REVIEW=1
# Requests per minute / per day sent to the provider. 0 = the provider's default free-tier limit.
CODEGUARD_LLM_RPM=0
CODEGUARD_LLM_RPD=0
# Seconds to wait for one AI answer, and how many times to retry a failed call
CODEGUARD_LLM_TIMEOUT=90
CODEGUARD_LLM_MAX_RETRIES=4
# Most Python files the LLM review looks at in one scan
CODEGUARD_LLM_MAX_FILES=20

# --- Scanners ---
# Full path to semgrep.exe. Leave empty to auto-detect (.venv-semgrep, then PATH).
CODEGUARD_SEMGREP_PATH=
# Semgrep ruleset
CODEGUARD_SEMGREP_CONFIG=p/python
# Seconds each scanner may run before it is stopped
CODEGUARD_SCANNER_TIMEOUT=120

# --- Limits ---
# Maximum lines of pasted code
CODEGUARD_MAX_PASTE_LINES=2000

# --- Rule checks (PyPI and OSV lookups) ---
# Where PyPI and OSV answers are cached (default: .cache in the repo root)
CODEGUARD_CACHE_DIR=
# Seconds to wait for one PyPI or OSV request
CODEGUARD_NET_TIMEOUT=10
# 1 = never go online; package and vulnerability checks use cached answers only
CODEGUARD_OFFLINE=0
